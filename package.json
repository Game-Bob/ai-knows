{
    "name": "ai-knows",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Personal intelligence hub for extracting, normalizing, and packaging business data for AI analysis.",
    "scripts": {
        "dev": "tsx --env-file=.env watch src/index.ts",
        "sync": "tsx --env-file=.env src/index.ts",
        "start": "tsx --env-file=.env src/index.ts",
        "build": "tsc --project tsconfig.json",
        "check": "tsc --noEmit --project tsconfig.check.json",
        "lint": "eslint src/ tests/ *.config.ts --max-warnings 0",
        "format": "prettier . --write",
        "test": "vitest run",
        "discover": "npm run discover:suggest",
        "discover:suggest": "tsx --env-file=.env src/discover.ts",
        "discover:verticals": "tsx --env-file=.env src/discover-verticals.ts",
        "social": "tsx --env-file=.env src/social.ts",
        "render:image": "tsx scripts/render-tool-image.ts",
        "editor": "tsx scripts/serve-image-editor.ts",
        "editor:image": "tsx scripts/serve-image-editor.ts",
        "cloudflare:report": "tsx --env-file=.env scripts/cloudflare-report.ts",
        "issues": "tsx scripts/list-utility-issues.ts",
        "generate-workspace": "tsx scripts/generate-workspace.ts",
        "verify": "npm run check && npm run lint && npm run test"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "eslint": "^9.39.4",
        "eslint-plugin-no-comments": "^1.1.10",
        "prettier": "^3.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.2"
    },
    "dependencies": {
        "playwright-core": "^1.62.1",
        "sharp": "^0.35.3"
    }
}
